#
# The SDK-bearing applications of the reference estate in one image: the Python API and jobs, the Bun gateway and the Vite web build
# (Linux Node 22), from THIS tree. `go run ./tools/smoke journeys` builds it from a context it assembles:
#   opt/node/bin/node   the Linux Node 22 binary
#   opt/bun/bin/bun     the Linux Bun binary
#   app/                examples/reference, sdk/python/src, packages, package.json, tsconfig.base.json, pnpm-workspace.yaml and the
#                       pnpm workspace's node_modules, exactly as the repository holds them
#   wheels/             the hash-locked wheels for THIS image's interpreter (empty: pip reaches its index; the lock's hashes decide)
# BASE is the pinned Python image (an image id or name@sha256:<digest>, never a tag): build with the classic builder
# (DOCKER_BUILDKIT=0), which resolves a local image id, and with `--network=none --pull=false` when `wheels/` holds the wheels.
ARG BASE
FROM ${BASE}
ARG PIP_ARGS=
COPY opt/ /opt/
COPY app/ /app/
COPY wheels/ /wheels/
RUN python -m pip install --quiet --require-hashes --no-deps --only-binary=:all: --disable-pip-version-check --target /site ${PIP_ARGS} -r /app/examples/reference/requirements.lock \
 && find /site -name __pycache__ -type d -prune -exec rm -rf {} + \
 && rm -rf /wheels \
 && chmod -R a+rX /site /app /opt
ENV PYTHONPATH=/site:/app/sdk/python/src PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
WORKDIR /app
USER 65534:65534
