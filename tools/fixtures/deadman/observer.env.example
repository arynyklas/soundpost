#
# Settings of one external deadman observer. Copy to observer.env, edit, chmod 600.
# run-observer.sh reads this file; the observer itself reads only the two credentials, and only from
# its environment. Nothing in this file is a real credential: run-observer.sh refuses the
# "replace-me" placeholders and a shared poll/delivery credential.

# The observer's identity. Its state belongs to this identity and nothing else may reuse it.
OBSERVER_ID=deadman-production

# The observer's OWN storage: not under the product's data directory, not on a volume the product
# uses. It holds state.json (the record of every outage) and attempts.jsonl (append-only).
OBSERVER_STATE_DIR=/var/lib/soundpost-deadman

# The heartbeats to poll, name=url pairs. The three component names are the product's three
# separately failing parts (docs/operations/external-deadman.md, "Heartbeat semantics").
OBSERVER_POLL=product=https://soundpost.example.test/heartbeat/product,ingest=https://soundpost.example.test/heartbeat/ingest,notification=https://soundpost.example.test/heartbeat/notification

# The schedule. missing-after is chosen from the product's own cadence plus margin.
OBSERVER_INTERVAL=1s
OBSERVER_MISSING_AFTER=30s
OBSERVER_TIMEOUT=5s
OBSERVER_MAX_ATTEMPTS=8

# Where an outage is delivered, and the host:port list the observer may deliver to. The destination
# must be read by a human who does not depend on the product to be told, and the path to it must not
# pass through the product, its ingress or its egress allowlist.
OBSERVER_DESTINATION=https://alerts.example.test/notify
OBSERVER_AUTHORIZED_DESTINATION=alerts.example.test:443

# TEST ONLY: permit a loopback or private destination (the drills use it for their loopback
# receiver). Leave empty in a real deployment.
OBSERVER_TEST_ALLOW_LOOPBACK=

# Two DIFFERENT credentials. The poll credential is a read-scoped service credential issued to the
# observer that can read the heartbeat endpoints only; the delivery credential is for the
# destination and the product does not hold it. Neither belongs in product control state.
OBSERVER_POLL_TOKEN=replace-me-poll-credential
OBSERVER_DELIVERY_TOKEN=replace-me-delivery-credential
